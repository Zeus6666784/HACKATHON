# Server Environment Example
# Do NOT commit real credentials to source control.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/careconnect
JWT_SECRET=your_secure_jwt_secret_here
NODE_ENV=development

# NVIDIA NIM AI Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Optional Sarvam AI Configuration
SARVAM_AI_API_KEY=your_sarvam_api_key_here
